% =============================================================================
% CATEGORY 1: NEOREALISM-CONSTRUCTIVISM THEORETICAL DEBATE
% =============================================================================
% These are your foundational IR theory sources. You MUST read the primary
% sources (Waltz, Wendt) deeply - don't rely on summaries.

@book{morgenthau1978,
  author    = {Hans J. Morgenthau},
  title     = {Politics Among Nations: The Struggle for Power and Peace},
  edition   = {5th Revised},
  year      = {1978},
  publisher = {Alfred A. Knopf},
  address   = {New York},
  pages     = {4--15}
}
% COMMENT: Classical realism predecessor to Waltz. Establishes power as central
% concept in IR. Less relevant than Waltz for your structural focus, but useful
% for historical context of realist tradition.

@book{waltz1979,
  author    = {Kenneth N. Waltz},
  title     = {Theory of International Politics},
  year      = {1979},
  publisher = {Addison-Wesley},
  address   = {Reading, MA}
}
% COMMENT: ESSENTIAL. Foundational neorealist text. Key claims: (1) anarchy +
% distribution of capabilities determines state behavior, (2) states are
% "functionally undifferentiated" units, (3) self-help follows from structure.
% Your RL agents should operationalize these assumptions.

@article{wendt1992,
  author  = {Alexander Wendt},
  title   = {Anarchy is What States Make of It: The Social Construction of Power Politics},
  journal = {International Organization},
  year    = {1992},
  volume  = {46},
  number  = {2},
  pages   = {391--425}
}
% COMMENT: ESSENTIAL. The constructivist challenge to Waltz. Key claim: "Self-help
% and power politics do not follow either logically or causally from anarchy."
% Identities and interests are socially constructed through interaction.
% Your LLM agents should operationalize this - identity formation through history.

@article{mearsheimer1994,
  author  = {John J. Mearsheimer},
  title   = {The False Promise of International Institutions},
  journal = {International Security},
  year    = {1994},
  volume  = {19},
  number  = {3},
  pages   = {5--49}
}
% COMMENT: Neorealist critique of institutionalism and constructivism. Argues
% institutions have "minimal influence on state behavior." Part of the direct
% Mearsheimer-Wendt exchange that crystallized the debate.

@article{wendt1995,
  author  = {Alexander Wendt},
  title   = {Constructing International Politics},
  journal = {International Security},
  year    = {1995},
  volume  = {20},
  number  = {1},
  pages   = {71--81}
}
% COMMENT: Wendt's response to Mearsheimer. Clarifies that constructivism shares
% some assumptions with neorealism (states as units, systemic focus) but argues
% neorealism is "not structural enough" - fails to examine how social structures
% constitute identities. Good for understanding the precise disagreement.

@book{katzenstein1996,
  author    = {Peter J. Katzenstein},
  title     = {The Culture of National Security: Norms and Identity in World Politics},
  year      = {1996},
  publisher = {Columbia University Press},
  address   = {New York}
}
% COMMENT: Edited volume demonstrating constructivism's empirical applicability
% to security studies. Contributors include Wendt, Finnemore, Johnston. Shows
% how culture, norms, and identity shape national security policies.

@book{finnemore1996,
  author    = {Martha Finnemore},
  title     = {National Interests in International Society},
  year      = {1996},
  publisher = {Cornell University Press},
  address   = {Ithaca, NY}
}
% COMMENT: Empirical constructivist work. Key argument: interests are "not just
% 'out there' waiting to be discovered; they are constructed through social
% interaction." Supports endogenous interest formation in your LLM agents.

@book{wendt1999,
  author    = {Alexander Wendt},
  title     = {Social Theory of International Politics},
  year      = {1999},
  publisher = {Cambridge University Press},
  address   = {Cambridge}
}
% COMMENT: ESSENTIAL. Constructivism's magnum opus. Develops three "cultures of
% anarchy": Hobbesian (enemies), Lockean (rivals), Kantian (friends). These are
% shared ideas that shape state behavior. Won ISA Best Book of the Decade.
% Could inform different LLM prompt conditions in your experiments.

@book{mearsheimer2001,
  author    = {John J. Mearsheimer},
  title     = {The Tragedy of Great Power Politics},
  year      = {2001},
  publisher = {W.W. Norton},
  address   = {New York}
}
% COMMENT: Offensive realism - argues great powers are compelled by anarchy to
% maximize power share. Five core assumptions you could operationalize in RL:
% (1) anarchic system, (2) offensive military potential, (3) uncertainty about
% intentions, (4) survival as primary goal, (5) rational actors.

@book{barkin2010,
  author    = {J. Samuel Barkin},
  title     = {Realist Constructivism: Rethinking International Relations Theory},
  year      = {2010},
  publisher = {Cambridge University Press},
  address   = {Cambridge}
}
% COMMENT: Attempt at synthesis - combining realism's focus on power with
% constructivism's attention to social construction. Useful for discussing
% whether your hybrid RL-LLM approach represents a computational synthesis.


% =============================================================================
% CATEGORY 2: AGENT-BASED MODELING IN IR
% =============================================================================
% These establish ABM methodology in IR and identify the gap your thesis fills.

@book{axelrod1984,
  author    = {Robert Axelrod},
  title     = {The Evolution of Cooperation},
  year      = {1984},
  publisher = {Basic Books},
  address   = {New York}
}
% COMMENT: Classic. Iterated Prisoner's Dilemma tournaments showing Tit-for-Tat
% is robust. Foundational for modeling cooperation under anarchy. Your game
% mechanics (invest, arm, attack) relate to this tradition.

@book{axelrod1997,
  author    = {Robert Axelrod},
  title     = {The Complexity of Cooperation: Agent-Based Models of Competition and Collaboration},
  year      = {1997},
  publisher = {Princeton University Press},
  address   = {Princeton, NJ}
}
% COMMENT: Extension of cooperation work using ABM. Shows norms can emerge
% through decentralized interactions. Relevant for your coalition formation
% research question.

@book{epstein1996,
  author    = {Joshua M. Epstein and Robert Axtell},
  title     = {Growing Artificial Societies: Social Science from the Bottom Up},
  year      = {1996},
  publisher = {MIT Press},
  address   = {Cambridge, MA}
}
% COMMENT: Foundational ABM text. "Sugarscape" model demonstrates emergent
% social phenomena from simple rules. Supports your "General Sufficiency"
% principle - complex outcomes from minimal mechanisms.

@book{cederman1997,
  author    = {Lars-Erik Cederman},
  title     = {Emergent Actors in World Politics: How States and Nations Develop and Dissolve},
  year      = {1997},
  publisher = {Princeton University Press},
  address   = {Princeton, NJ}
}
% COMMENT: Pioneered ABM in IR. Uses Complex Adaptive Systems to study state
% formation and balance of power. Demonstrates ABM can address core IR questions.

@article{cederman2002,
  author  = {Lars-Erik Cederman},
  title   = {Endogenizing Geopolitical Boundaries with Agent-Based Modeling},
  journal = {Proceedings of the National Academy of Sciences},
  year    = {2002},
  volume  = {99},
  number  = {Suppl 3},
  pages   = {7296--7303}
}
% COMMENT: GeoSim model - states as territorial organizations with power from
% extractable resources. Shows balance of power can emerge endogenously.
% Results were parameter-dependent - a methodological caution for your work.

@article{lustick2000,
  author  = {Ian S. Lustick},
  title   = {Agent-based modelling of collective identity: testing constructivist theory},
  journal = {Journal of Artificial Societies and Social Simulation},
  year    = {2000},
  volume  = {3},
  number  = {1}
}
% COMMENT: IMPORTANT. The ONLY dedicated constructivist ABM study. Operationalized
% identities as agent "repertoires" with activation rules. Found tipping/cascade
% effects with exclusivist identities. Acknowledged "highly stylized" - you can
% argue LLMs offer richer identity representation.

@article{cederman2003,
  author  = {Lars-Erik Cederman and Christopher Daase},
  title   = {Endogenizing Corporate Identities: The Next Step in Constructivist IR Theory},
  journal = {European Journal of International Relations},
  year    = {2003},
  volume  = {9},
  number  = {1},
  pages   = {5--35}
}
% COMMENT: Argues constructivists need formal modeling tools MORE than rationalists
% because they study dynamic, complex processes. Call has gone largely unanswered
% until now - positions your thesis as filling this gap.

@article{earnest2008,
  author  = {David C. Earnest},
  title   = {Coordination in Large Numbers: An Agent-Based Model of International Negotiations},
  journal = {International Studies Quarterly},
  year    = {2008},
  volume  = {52},
  number  = {2},
  pages   = {363--382}
}
% COMMENT: ABM applied to international negotiations. Found path histories matter
% for cooperation outcomes - supports importance of memory/history in your model.


