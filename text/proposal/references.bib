@article{hua2023waragent,
  author  = {Wenyue Hua and others},
  title   = {WarAgent: Simulating World Wars with Large Language Models},
  journal = {arXiv preprint arXiv:2311.17227},
  year    = {2023}
}
% COMMENT: IMPORTANT. Simulated WWI, WWII, Warring States with LLM country agents.
% Successfully replicated macro outcomes (alliance formations, war sequences).
% Shows LLMs can model state behavior in IR contexts. Doesn't ground in theory.

@article{liang2025unbench,
  author  = {Yueyang Liang and others},
  title   = {UNBench: Instructing Large Language Models to be Political Scientists},
  journal = {arXiv preprint arXiv:2502.14122},
  year    = {2025}
}
% COMMENT: First benchmark for LLMs in political science using UN Security Council
