  journal = {Journal of Artificial Societies and Social Simulation},
  year    = {2023},
  volume  = {26},
  number  = {1}
}
% COMMENT: Comprehensive review finding 38/71 ABM applications (54%) use RL for
% behavioral specifications. RL improves "accuracy of behavioral modeling."
% Validates your methodological choice.

@inproceedings{leibo2017,
  author    = {Joel Z. Leibo and Vinicius Zambaldi and Marc Lanctot and Janusz Marber and Thore Graepel},
  title     = {Multi-agent Reinforcement Learning in Sequential Social Dilemmas},
  booktitle = {Proceedings of the 16th International Conference on Autonomous Agents and Multiagent Systems (AAMAS)},
  year      = {2017},
  pages     = {464--473}
}
% COMMENT: Applied Deep Q-Networks to Markov games. Found conflict emerges from
% competition over shared resources. Sequential structure affects cooperation.
% Directly relevant to your game design.

@article{tampuu2017,
  author  = {Ardi Tampuu and Tambet Matiisen and Dorian Kodelja and Ilya Kuzovkin and Kristjan Korjus and Juhan Aru and Jaan Aru and Raul Vicente},
  title   = {Multiagent cooperation and competition with deep reinforcement learning},
  journal = {PLOS ONE},
  year    = {2017},
  volume  = {12},
  number  = {4},
  pages   = {e0172395}
}
% COMMENT: Showed competitive RL agents learn efficient scoring; collaborative
% agents find optimal cooperation. Behavior determined by reward structure.
% Supports your design where RL reward function embodies neorealist assumptions.

@article{ning2024,
  author  = {Ming Ning and Shichao Xie},
  title   = {A Survey on Multi-Agent Reinforcement Learning and Its Application},
  journal = {Journal of Automation and Intelligence},
  year    = {2024},
  volume  = {3},
  pages   = {73--91}
}
% COMMENT: Recent comprehensive MARL survey. Notes MARL is "notoriously sample-
% inefficient, often requiring millions of interactions." Important limitation
% to acknowledge in your methods.

@article{pan2025,
  author  = {Yi Pan},
  title   = {Reinforcement Learning-Based Optimization and Simulation Modeling of International Relations Interaction Strategies},
  journal = {Journal of Combinatorial Mathematics and Combinatorial Computing},
  year    = {2025},
  volume  = {127b},
  pages   = {9423--9441}
}
% COMMENT: Most direct IR application of RL. Found: close economic links reduce
% conflict; high cooperation gains lead to cooperative strategies. Supports
% liberal interdependence computationally. Doesn't address neorealism-constructivism.


