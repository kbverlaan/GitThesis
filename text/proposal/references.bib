% capabilities and limitations in IR domain.

@inproceedings{rivera2024,
  author    = {Juan-Pablo Rivera and others},
  title     = {Escalation Risks from Language Models in Military and Diplomatic Decision-Making},
  booktitle = {ACM Conference on Fairness, Accountability, and Transparency (FAccT)},
  year      = {2024}
}
% COMMENT: Stanford HAI study - all 5 LLMs showed escalation patterns in wargames,
% some leading to nuclear use. First study using IR escalation literature to
% evaluate LLM behavior. Caution for your simulations.

@article{horiguchi2024,
  author  = {Tomonori Horiguchi and Takashi Ikegami},
  title   = {Norm Emergence through Social Learning: A Study of Multi-Agent Societies},
  journal = {arXiv preprint arXiv:2409.00993},
  year    = {2024}
}
% COMMENT: IMPORTANT for constructivism. LLM agents spontaneously generate norms
% AND metanorms (punishing those who don't punish cheaters) through conversation.
% Strong evidence for constructivist norm emergence via LLMs.

@article{leng2023,
  author  = {Yancheng Leng and Jianhui Yuan},
  title   = {Do LLM Agents Exhibit Social Behavior?},
  journal = {arXiv preprint arXiv:2312.15198},
  year    = {2023}
}
% COMMENT: Found LLMs display direct/indirect reciprocity, social welfare
% considerations, and GROUP IDENTITY EFFECTS. Higher-capacity models show
% stronger identity effects. Directly supports LLM-constructivist mapping.


% =============================================================================
% CATEGORY 5: COMPUTATIONAL IR METHODOLOGY & GENERATIVE ABM VALIDATION
% =============================================================================
% These establish the methodological gap AND how to properly position
% generative agent research (crucial for defending your approach).

@article{larooij2025,
  author  = {Maik Larooij and Petter Törnberg},
  title   = {Can Generative AI Agents Represent Us? A Study on the Validity of Large Language Model-Based Agents},
  journal = {arXiv preprint},
  year    = {2025}
}
% COMMENT: CRITICAL FOR YOUR METHODOLOGY FRAMING. Larooij & Törnberg identify
% validation challenges for generative ABMs but argue they can be productive when:
%   1. Focus on MACRO-LEVEL PATTERNS (like Schelling) not micro-level realism
%   2. Aim for EXPLANATION/UNDERSTANDING not accurate prediction
%   3. Test COUNTERFACTUALS ("what-if" scenarios)
%   4. Study LLM LIMITATIONS themselves
%
% YOUR THESIS FITS THIS FRAMEWORK PERFECTLY:
%   - You test theoretical mechanisms (neorealism vs constructivism) not
%     whether individual "states" behave realistically
%   - You ask "CAN materialist optimization produce hierarchy?" not
%     "WILL China attack Taiwan?"
%   - You compare three configurations as counterfactuals
%   - You don't need LLMs to perfectly simulate humans; you need them to
%     represent normative reasoning consistent with constructivist theory
%
% USE THIS TO FRAME YOUR VALIDATION STRATEGY:
%   NOT validating: micro-level realism of individual agent decisions
%   VALIDATING: (1) internal theoretical coherence - do RL agents behave
%               consistently with neorealist assumptions? Do LLMs show
%               norm-based reasoning consistent with constructivism?
%               (2) macro-pattern differences - do different configurations
%               produce different emergent structures?
%               (3) mechanism identification - what interaction patterns
%               precede hierarchy formation?

@article{unver2018,
  author  = {H. Akin Unver},
  title   = {Computational International Relations: What Can Programming, Coding and Internet Research Do for the Discipline?},
  journal = {All Azimuth: A Journal of Foreign Policy and Peace},
  year    = {2018},
  volume  = {7},
  number  = {2},
  pages   = {157--182}
}
% COMMENT: IMPORTANT. Identifies "vast methodological gap" in computational IR.
% Methods remain underdeveloped compared to other computational social sciences.
% Directly motivates your thesis contribution.

@article{pepinsky2005,
